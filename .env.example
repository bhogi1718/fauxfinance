# Copy to .env and fill in the values. Never commit .env.

# Local Postgres from docker-compose.yml (host port defaults to 5433 to avoid clashing with other local Postgres instances)
POSTGRES_PORT=5433
DATABASE_URL=postgresql://fauxfinance:fauxfinance_dev@localhost:5433/fauxfinance

# Better Auth — generate with: openssl rand -base64 32  (must be 32+ characters)
BETTER_AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Market data. Leave FINNHUB_API_KEY empty to run on simulated prices (great for local dev).
# Free key: https://finnhub.io/register
FINNHUB_API_KEY=
# auto = Finnhub when a key is set, otherwise mock. Or force: finnhub | mock
MARKET_DATA_PROVIDER=auto

# How long a fetched quote is served from the in-memory cache
QUOTE_CACHE_TTL_MS=15000

# Better Auth sign-in/sign-up rate limiting. Defaults to on in production, off otherwise.
# AUTH_RATE_LIMIT=true
