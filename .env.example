# Copy to .env and fill in the values. Never commit .env.

# Local Postgres from docker-compose.yml (host port defaults to 5433 to avoid clashing with other local Postgres instances)
POSTGRES_PORT=5433
DATABASE_URL=postgresql://fauxfinance:fauxfinance_dev@localhost:5433/fauxfinance

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Finnhub free tier key: https://finnhub.io/register
FINNHUB_API_KEY=replace-with-your-finnhub-key

# How long a fetched quote is served from the in-memory cache
QUOTE_CACHE_TTL_MS=15000
